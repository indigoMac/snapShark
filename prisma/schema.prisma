generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used by prisma migrate against Neon/Supabase poolers (direct Postgres, not PgBouncer).
  directUrl = env("DIRECT_URL")
}

model User {
  id          String @id @default(uuid())
  clerkUserId String @unique

  /// Billing state. Stripe is the origin of truth; these columns are the copy
  /// the app reads, so entitlements can be enforced server-side.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  plan                 String    @default("free")
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  dives     Dive[]
  diveSites DiveSite[]
  trips     Trip[]
}

model Trip {
  id          String     @id @default(uuid())
  userId      String
  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  /// Unguessable token. Present means anyone with the link can view this trip.
  shareToken  String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  places      DiveSite[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DiveSite {
  id          String    @id @default(uuid())
  name        String
  description String?
  userId      String
  tripId      String?
  latitude    Decimal   @db.Decimal(9, 6)
  longitude   Decimal   @db.Decimal(9, 6)
  country     String?
  region      String?
  /// Unguessable token. Present means anyone with the link can view this place.
  shareToken  String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dives       Dive[]
  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip        Trip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tripId])
}

model Dive {
  id                 String    @id @default(uuid())
  userId             String
  siteId             String?
  diveDate           DateTime
  diveType           String?
  depthMeters        Decimal?  @db.Decimal(5, 2)
  bottomTimeMinutes  Int?
  buddy              String?
  conditions         Json?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  photos             Photo[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site DiveSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([siteId])
}

model Photo {
  id         String    @id @default(uuid())
  diveId     String
  /// Blob pathname for private storage, or a data URL on installs without blob storage.
  storageRef String
  caption    String?
  takenAt    DateTime?
  latitude   Decimal?  @db.Decimal(9, 6)
  longitude  Decimal?  @db.Decimal(9, 6)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  dive Dive @relation(fields: [diveId], references: [id], onDelete: Cascade)

  @@index([diveId])
}
