# SnapShark environment template
# Copy to `.env` for local development (never commit real secrets).
# Production values live in Vercel Project Settings → Environment Variables.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional feature flags
NEXT_PUBLIC_ENABLE_HEIC=true
NEXT_PUBLIC_ENABLE_AVIF=true
NEXT_PUBLIC_ENABLE_PICA=true

# --- Auth (Clerk) ---
# Use Clerk Development instance keys locally.
# Use Clerk Production instance keys only in Vercel Production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret for the Clerk webhook that erases logbook data on account deletion.
# Clerk Dashboard → Webhooks → endpoint `/api/clerk/webhook`, subscribe to `user.deleted`.
CLERK_WEBHOOK_SECRET=

# --- Billing (Stripe) ---
# Prefer Stripe test-mode keys locally; live keys only in production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=

# --- Database (Prisma) ---
# Local (Homebrew Postgres): both can be the same URL.
DATABASE_URL="postgresql://mackenziecox@127.0.0.1:5432/snapshark_dev"
DIRECT_URL="postgresql://mackenziecox@127.0.0.1:5432/snapshark_dev"
#
# Production (Neon / Supabase) — set only in Vercel Production:
# DATABASE_URL = pooled connection string (app / serverless)
# DIRECT_URL   = direct connection string (migrations only)
# Never point local tooling at the production database.
#
# Optional photo storage (recommended in Production + Preview):
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Without it, photos stay as compressed data URLs (OK for local/dev only).
